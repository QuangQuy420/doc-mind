# Values come from `terraform -chdir=infra/envs/dev output`.
# Copy to .env.production (deploy) or .env.local (dev); both are git-ignored.

# terraform output api_url — e.g. https://api.example.com
VITE_API_BASE_URL=
# terraform output cognito_issuer — the OIDC issuer the SPA discovers metadata from
VITE_COGNITO_AUTHORITY=
# terraform output cognito_client_id — the public (PKCE) app client
VITE_COGNITO_CLIENT_ID=
# terraform output cognito_hosted_ui_domain — full base URL, e.g. https://xxx.auth.<region>.amazoncognito.com
VITE_COGNITO_DOMAIN=
# terraform output site_url + "/" — must end with "/" to match the Cognito callback URL.
# Locally: http://localhost:5173/
VITE_REDIRECT_URI=
