# Copy to apps/api/.env and fill in the Cognito values from
# `terraform -chdir=infra/envs/dev output`. Never commit the real .env.
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=docmind-dev-documents
# DynamoDB Local from docker-compose. Remove (or comment out) this line to talk
# to real AWS - an empty value is an invalid endpoint, not "unset".
DYNAMODB_ENDPOINT_URL=http://localhost:8000
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/<user_pool_id>
COGNITO_CLIENT_ID=<app_client_id>
DATABASE_URL=postgresql+psycopg://docmind:docmind@localhost:5432/docmind
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
APP_VERSION=0.1.0
